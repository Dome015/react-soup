{
  "name": "react-soup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A vendorable, token-driven UI library for React and plain web projects",
  "exports": {
    ".": "./src/react/index.ts",
    "./styles.css": "./src/shared/styles/index.css",
    "./vanilla": "./src/vanilla/dist/behavior.js"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build-vanilla": "node scripts/build-vanilla.mjs",
    "vanilla:stories": "vite --host 127.0.0.1 --port 6007",
    "snapshot:vanilla": "node --experimental-strip-types scripts/snapshot-react-stories.ts"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
